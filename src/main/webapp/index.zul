<?xml version="1.0" encoding="UTF-8"?>

<?page title="CTS Banking"?>

<zk>

    <style>

        /* ============================================================
           RESET
           ============================================================ */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Arial, sans-serif;
        }

        html, body {
            height: 100%;
            overflow: hidden;
        }

        /* ============================================================
           SHELL LAYOUT
           Three areas: header (top), sidebar (left), content (right)
           ============================================================ */

        .shell-root {
            width: 100vw;
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }


        /* ============================================================
           HEADER
           ============================================================ */

        .shell-header,
        .shell-header.z-hlayout {
            width: 100% !important;
            height: 56px !important;
            min-height: 56px !important;
            background: #18243A !important;
            display: flex !important;
            align-items: center !important;
            padding: 0 24px !important;
            box-sizing: border-box !important;
            flex-shrink: 0 !important;
            z-index: 100 !important;
        }

        .header-right,
        .header-right.z-hlayout {
            display: flex !important;
            align-items: center !important;
            gap: 20px !important;
            margin-left: auto !important;
        }

        .header-meta-group,
        .header-meta-group.z-hlayout {
            display: flex !important;
            align-items: center !important;
            gap: 6px !important;
        }

        .header-menu-icon {
            color: #FFFFFF !important;
            font-size: 20px !important;
            font-weight: 700 !important;
            margin-right: 14px !important;
            cursor: pointer !important;
            letter-spacing: 2px !important;
        }

        .header-brand {
            color: #FFFFFF !important;
            font-size: 16px !important;
            font-weight: 700 !important;
            letter-spacing: 0.5px !important;
            flex: 1 !important;
        }

        .header-meta-icon {
            font-size: 14px !important;
            color: #B0BBCC !important;
        }

        .header-meta-text {
            color: #B0BBCC !important;
            font-size: 13px !important;
        }

        .header-divider {
            width: 1px;
            height: 22px;
            background: #2E3D56;
            display: inline-block;
        }

        .header-notif {
            position: relative;
            cursor: pointer;
        }

        .header-notif-icon {
            color: #B0BBCC !important;
            font-size: 18px !important;
        }

        .header-avatar {
            width: 32px;
            height: 32px;
            background: #2E3D56;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .header-avatar-icon {
            color: #B0BBCC !important;
            font-size: 18px !important;
        }


        /* ============================================================
           BODY ROW  (sidebar + content side by side)
           ============================================================ */

        .shell-body,
        .shell-body.z-hlayout {
            display: flex !important;
            flex: 1 !important;
            overflow: hidden !important;
            width: 100% !important;
        }

        /* ============================================================
           SIDEBAR
           ============================================================ */

        .shell-sidebar,
        .shell-sidebar.z-vlayout {
            width: 200px !important;
            min-width: 200px !important;
            background: #1E2D45 !important;
            height: 100% !important;
            display: flex !important;
            flex-direction: column !important;
            overflow-y: auto !important;
            flex-shrink: 0 !important;
        }

        /* Nav item wrapper — target the z-div ZK generates */
        .nav-item,
        .nav-item > .z-div {
            width: 100% !important;
            height: 48px !important;
            display: flex !important;
            align-items: center !important;
            padding: 0 20px !important;
            cursor: pointer !important;
            box-sizing: border-box !important;
            border-left: 3px solid transparent !important;
            transition: background 0.15s !important;
        }

        .nav-item:hover,
        .nav-item:hover > .z-div {
            background: #26384F !important;
        }

        /* Active state */
        .nav-item-active,
        .nav-item-active > .z-div {
            background: #2454D6 !important;
            border-left: 3px solid #FFFFFF !important;
        }

        .nav-item-active .nav-label {
            color: #FFFFFF !important;
            font-weight: 700 !important;
        }

        .nav-item-active .nav-icon {
            color: #FFFFFF !important;
        }

        /* Icon — ZK wraps label in span.z-label */
        .nav-icon,
        .nav-icon.z-label {
            color: #8CA4BE !important;
            font-size: 16px !important;
            width: 22px !important;
            margin-right: 10px !important;
            flex-shrink: 0 !important;
            display: inline-block !important;
        }

        /* Label */
        .nav-label,
        .nav-label.z-label {
            color: #B0BBCC !important;
            font-size: 14px !important;
            font-weight: 500 !important;
            white-space: nowrap !important;
            display: inline-block !important;
        }


        /* ============================================================
           CONTENT AREA
           ============================================================ */

        .shell-content {
            flex: 1;
            height: 100%;
            overflow-y: auto;
            background: #F5F7FC;
        }

        /* ZK include fills full height */
        .shell-content .z-include {
            display: block;
            width: 100%;
            min-height: 100%;
        }

    </style>


    <!-- ============================================================
         SHELL CONTROLLER
         Handles sidebar navigation and content swapping
         ============================================================ -->

    <div sclass="shell-root"
         apply="com.cts.admin.controller.ShellController">


        <!-- ========================================================
             HEADER
             hlayout keeps items in a single horizontal row
             ======================================================== -->

        <hlayout sclass="shell-header"
                 spacing="0">

            <label sclass="header-menu-icon" value="|||"/>
            <label sclass="header-brand" value="CTS BANKING / DASHBOARD"/>

            <!-- Right side meta — hlayout for inline items -->
            <hlayout sclass="header-right" spacing="0">

                <hlayout sclass="header-meta-group" spacing="4px">
                    <label sclass="header-meta-icon" value="📅"/>
                    <label id="headerDate" sclass="header-meta-text" value=""/>
                </hlayout>

                <div sclass="header-divider"/>

                <hlayout sclass="header-meta-group" spacing="4px">
                    <label sclass="header-meta-icon" value="🕐"/>
                    <label id="headerLastLogin" sclass="header-meta-text" value="Last Login : --"/>
                </hlayout>

                <div sclass="header-divider"/>

                <div sclass="header-notif">
                    <label sclass="header-notif-icon" value="🔔"/>
                </div>

                <div sclass="header-avatar">
                    <label sclass="header-avatar-icon" value="👤"/>
                </div>

            </hlayout>

        </hlayout>


        <!-- ========================================================
             BODY ROW
             hlayout places sidebar and content side by side
             ======================================================== -->

        <hlayout sclass="shell-body" spacing="0">

            <!-- ====================================================
                 SIDEBAR
                 vlayout stacks nav items vertically
                 ==================================================== -->

            <vlayout sclass="shell-sidebar" spacing="0">

                <!-- Dashboard -->
                <div id="navDashboard" sclass="nav-item">
                    <label sclass="nav-icon" value="⌂"/>
                    <label sclass="nav-label" value="Dashboard"/>
                </div>

                <!-- Role Management -->
                <div id="navRoles" sclass="nav-item">
                    <label sclass="nav-icon" value="◈"/>
                    <label sclass="nav-label" value="Role Management"/>
                </div>

                <!-- User Management -->
                <div id="navUsers" sclass="nav-item">
                    <label sclass="nav-icon" value="👤"/>
                    <label sclass="nav-label" value="User Management"/>
                </div>

                <!-- Batch Monitoring -->
                <div id="navBatch" sclass="nav-item">
                    <label sclass="nav-icon" value="〜"/>
                    <label sclass="nav-label" value="Batch Monitoring"/>
                </div>

                <!-- Session Management -->
                <div id="navSession" sclass="nav-item">
                    <label sclass="nav-icon" value="◎"/>
                    <label sclass="nav-label" value="Session Management"/>
                </div>

                <!-- Audit Logs -->
                <div id="navAudit" sclass="nav-item">
                    <label sclass="nav-icon" value="≡"/>
                    <label sclass="nav-label" value="Audit Logs"/>
                </div>

            </vlayout>


            <!-- ====================================================
                 CONTENT AREA
                 Dynamic include — swapped by ShellController
                 ==================================================== -->

            <div sclass="shell-content">

                <include id="contentArea"
                         src="/admin/roles.zul"/>

            </div>

        </hlayout>

    </div>

</zk>
