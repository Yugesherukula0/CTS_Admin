<?xml version="1.0" encoding="UTF-8"?>

<?page title="CTS Banking"?>

<zk>

    <style>

        /* ============================================================
           RESET
           ============================================================ */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Arial, sans-serif;
        }

        html, body {
            height: 100%;
            overflow: hidden;
        }

        /* ============================================================
           SHELL LAYOUT
           Three areas: header (top), sidebar (left), content (right)
           ============================================================ */

        .shell-root {
            width: 100vw;
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }


        /* ============================================================
           HEADER
           ============================================================ */

        .shell-header {
            width: 100%;
            height: 56px;
            min-height: 56px;
            background: #18243A;
            display: flex;
            align-items: center;
            padding: 0 24px;
            box-sizing: border-box;
            flex-shrink: 0;
            z-index: 100;
        }

        .header-menu-icon {
            color: #FFFFFF !important;
            font-size: 20px !important;
            font-weight: 700 !important;
            margin-right: 14px !important;
            cursor: pointer !important;
            letter-spacing: 2px !important;
        }

        .header-brand {
            color: #FFFFFF !important;
            font-size: 16px !important;
            font-weight: 700 !important;
            letter-spacing: 0.5px !important;
            flex: 1 !important;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-left: auto;
        }

        .header-meta-group {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .header-meta-icon {
            font-size: 14px !important;
            color: #B0BBCC !important;
        }

        .header-meta-text {
            color: #B0BBCC !important;
            font-size: 13px !important;
        }

        .header-divider {
            width: 1px;
            height: 22px;
            background: #2E3D56;
            display: inline-block;
        }

        .header-notif {
            position: relative;
            cursor: pointer;
        }

        .header-notif-icon {
            color: #B0BBCC !important;
            font-size: 18px !important;
        }

        .header-avatar {
            width: 32px;
            height: 32px;
            background: #2E3D56;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }

        .header-avatar-icon {
            color: #B0BBCC !important;
            font-size: 18px !important;
        }


        /* ============================================================
           BODY ROW  (sidebar + content side by side)
           ============================================================ */

        .shell-body {
            display: flex;
            flex: 1;
            overflow: hidden;
            width: 100%;
        }


        /* ============================================================
           SIDEBAR
           ============================================================ */

        .shell-sidebar {
            width: 200px;
            min-width: 200px;
            background: #1E2D45;
            height: 100%;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            flex-shrink: 0;
        }

        /* Nav item wrapper — target the z-div ZK generates */
        .nav-item,
        .nav-item > .z-div {
            width: 100% !important;
            height: 48px !important;
            display: flex !important;
            align-items: center !important;
            padding: 0 20px !important;
            cursor: pointer !important;
            box-sizing: border-box !important;
            border-left: 3px solid transparent !important;
            transition: background 0.15s !important;
        }

        .nav-item:hover,
        .nav-item:hover > .z-div {
            background: #26384F !important;
        }

        /* Active state */
        .nav-item-active,
        .nav-item-active > .z-div {
            background: #2454D6 !important;
            border-left: 3px solid #FFFFFF !important;
        }

        .nav-item-active .nav-label {
            color: #FFFFFF !important;
            font-weight: 700 !important;
        }

        .nav-item-active .nav-icon {
            color: #FFFFFF !important;
        }

        /* Icon — ZK wraps label in span.z-label */
        .nav-icon,
        .nav-icon.z-label {
            color: #8CA4BE !important;
            font-size: 16px !important;
            width: 22px !important;
            margin-right: 10px !important;
            flex-shrink: 0 !important;
            display: inline-block !important;
        }

        /* Label */
        .nav-label,
        .nav-label.z-label {
            color: #B0BBCC !important;
            font-size: 14px !important;
            font-weight: 500 !important;
            white-space: nowrap !important;
            display: inline-block !important;
        }


        /* ============================================================
           CONTENT AREA
           ============================================================ */

        .shell-content {
            flex: 1;
            height: 100%;
            overflow-y: auto;
            background: #F5F7FC;
        }

        /* ZK include fills full height */
        .shell-content .z-include {
            display: block;
            width: 100%;
            min-height: 100%;
        }

    </style>


    <!-- ============================================================
         SHELL CONTROLLER
         Handles sidebar navigation and content swapping
         ============================================================ -->

    <div sclass="shell-root"
         apply="com.cts.admin.controller.ShellController">


        <!-- ========================================================
             HEADER
             ======================================================== -->

        <div sclass="shell-header">

            <label sclass="header-menu-icon" value="|||"/>
            <label sclass="header-brand" value="CTS BANKING / DASHBOARD"/>

            <div sclass="header-right">

                <div sclass="header-meta-group">
                    <label sclass="header-meta-icon" value="📅"/>
                    <label id="headerDate" sclass="header-meta-text" value=""/>
                </div>

                <div sclass="header-divider"/>

                <div sclass="header-meta-group">
                    <label sclass="header-meta-icon" value="🕐"/>
                    <label id="headerLastLogin" sclass="header-meta-text" value="Last Login : --"/>
                </div>

                <div sclass="header-divider"/>

                <div sclass="header-notif">
                    <label sclass="header-notif-icon" value="🔔"/>
                </div>

                <div sclass="header-avatar">
                    <label sclass="header-avatar-icon" value="👤"/>
                </div>

            </div>

        </div>


        <!-- ========================================================
             BODY ROW
             sidebar + content area side by side via CSS flex
             ======================================================== -->

        <div sclass="shell-body">

            <!-- ====================================================
                 SIDEBAR
                 ==================================================== -->

            <div sclass="shell-sidebar">

                <!-- Dashboard -->
                <div id="navDashboard" sclass="nav-item">
                    <label sclass="nav-icon" value="⌂"/>
                    <label sclass="nav-label" value="Dashboard"/>
                </div>

                <!-- Role Management -->
                <div id="navRoles" sclass="nav-item">
                    <label sclass="nav-icon" value="◈"/>
                    <label sclass="nav-label" value="Role Management"/>
                </div>

                <!-- User Management -->
                <div id="navUsers" sclass="nav-item">
                    <label sclass="nav-icon" value="👤"/>
                    <label sclass="nav-label" value="User Management"/>
                </div>

                <!-- Batch Monitoring -->
                <div id="navBatch" sclass="nav-item">
                    <label sclass="nav-icon" value="〜"/>
                    <label sclass="nav-label" value="Batch Monitoring"/>
                </div>

                <!-- Session Management -->
                <div id="navSession" sclass="nav-item">
                    <label sclass="nav-icon" value="◎"/>
                    <label sclass="nav-label" value="Session Management"/>
                </div>

                <!-- Audit Logs -->
                <div id="navAudit" sclass="nav-item">
                    <label sclass="nav-icon" value="≡"/>
                    <label sclass="nav-label" value="Audit Logs"/>
                </div>

            </div>


            <!-- ====================================================
                 CONTENT AREA
                 Dynamic include — swapped by ShellController
                 ==================================================== -->

            <div sclass="shell-content">

                <include id="contentArea"
                         src="/admin/roles.zul"/>

            </div>

        </div>

    </div>

</zk>
