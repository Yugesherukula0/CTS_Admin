<?xml version="1.0" encoding="UTF-8"?>

<?page title="CTS Banking"?>

<zk>

    <style>

        /* ============================================================
           RESET
           ============================================================ */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Arial, sans-serif;
        }

        html, body {
            height: 100%;
            overflow: hidden;
        }


        /* ============================================================
           SHELL ROOT — full viewport, column layout
           ============================================================ */

        .shell-root {
            width: 100vw;
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }


        /* ============================================================
           HEADER
           Uses plain div so display:flex works without fighting ZK
           ============================================================ */

        .shell-header {
            width: 100%;
            height: 68px;
            min-height: 68px;
            background: #18243A;
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            padding: 0 28px;
            box-sizing: border-box;
            flex-shrink: 0;
        }

        /* Left: ||| icon + brand title */
        .header-left {
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: 12px;
        }

        .header-menu-icon,
        .header-menu-icon.z-label {
            color: #FFFFFF !important;
            font-size: 16px !important;
            font-weight: 900 !important;
            letter-spacing: 3px !important;
            cursor: pointer !important;
            white-space: nowrap !important;
        }

        .header-brand,
        .header-brand.z-label {
            color: #FFFFFF !important;
            font-size: 15px !important;
            font-weight: 700 !important;
            letter-spacing: 1px !important;
            white-space: nowrap !important;
        }

        /* Right: date | last login | bell | avatar */
        .header-right {
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: 0;
        }

        /* Date / Last Login group */
        .header-meta-group {
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: 6px;
            padding: 0 16px;
        }

        .header-meta-icon,
        .header-meta-icon.z-label {
            color: #8A9BB5 !important;
            font-size: 14px !important;
            flex-shrink: 0 !important;
        }

        .header-meta-text,
        .header-meta-text.z-label {
            color: #8A9BB5 !important;
            font-size: 13px !important;
            white-space: nowrap !important;
        }

        /* Thin vertical divider */
        .header-divider {
            width: 1px;
            height: 24px;
            background: #2E4060;
            flex-shrink: 0;
        }

        /* Bell + badge wrapper */
        .header-notif {
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 16px;
            cursor: pointer;
        }

        .header-notif-icon,
        .header-notif-icon.z-label {
            color: #8A9BB5 !important;
            font-size: 20px !important;
        }

        /* Red badge */
        .header-notif-badge,
        .header-notif-badge.z-label {
            position: absolute !important;
            top: -1px !important;
            right: 5px !important;
            background: #E53E3E !important;
            color: #FFFFFF !important;
            font-size: 10px !important;
            font-weight: 700 !important;
            min-width: 17px !important;
            height: 17px !important;
            border-radius: 9px !important;
            text-align: center !important;
            line-height: 17px !important;
            padding: 0 3px !important;
            box-sizing: border-box !important;
        }

        /* Avatar circle */
        .header-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 2px solid #4A5568;
            background: #2D3748;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            margin-left: 6px;
            flex-shrink: 0;
        }

        .header-avatar-icon,
        .header-avatar-icon.z-label {
            color: #8A9BB5 !important;
            font-size: 17px !important;
        }


        /* ============================================================
           BODY ROW — sidebar + content side by side
           ============================================================ */

        .shell-body,
        .shell-body.z-hlayout {
            display: flex !important;
            flex: 1 !important;
            overflow: hidden !important;
            width: 100% !important;
        }


        /* ============================================================
           SIDEBAR
           ============================================================ */

        .shell-sidebar,
        .shell-sidebar.z-vlayout {
            width: 200px !important;
            min-width: 200px !important;
            background: #1E2D45 !important;
            height: 100% !important;
            display: flex !important;
            flex-direction: column !important;
            overflow-y: auto !important;
            flex-shrink: 0 !important;
        }

        .nav-item,
        .nav-item > .z-div {
            width: 100% !important;
            height: 48px !important;
            display: flex !important;
            align-items: center !important;
            padding: 0 20px !important;
            cursor: pointer !important;
            box-sizing: border-box !important;
            border-left: 3px solid transparent !important;
            transition: background 0.15s !important;
        }

        .nav-item:hover,
        .nav-item:hover > .z-div {
            background: #26384F !important;
        }

        .nav-item-active,
        .nav-item-active > .z-div {
            background: #2454D6 !important;
            border-left: 3px solid #FFFFFF !important;
        }

        .nav-item-active .nav-label {
            color: #FFFFFF !important;
            font-weight: 700 !important;
        }

        .nav-item-active .nav-icon {
            color: #FFFFFF !important;
        }

        .nav-icon,
        .nav-icon.z-label {
            color: #8CA4BE !important;
            font-size: 16px !important;
            width: 22px !important;
            margin-right: 10px !important;
            flex-shrink: 0 !important;
            display: inline-block !important;
        }

        .nav-label,
        .nav-label.z-label {
            color: #B0BBCC !important;
            font-size: 14px !important;
            font-weight: 500 !important;
            white-space: nowrap !important;
            display: inline-block !important;
        }


        /* ============================================================
           CONTENT AREA
           ============================================================ */

        .shell-content {
            flex: 1;
            height: 100%;
            overflow-y: auto;
            background: #F5F7FC;
        }

        .shell-content .z-include {
            display: block;
            width: 100%;
            min-height: 100%;
        }

    </style>


    <div sclass="shell-root"
         apply="com.cts.admin.controller.ShellController">


        <!-- ========================================================
             HEADER
             div used intentionally — hlayout renders as display:table
             which breaks justify-content:space-between
             ======================================================== -->

        <div sclass="shell-header">

            <!-- Far left: ||| + brand -->
            <div sclass="header-left">
                <label sclass="header-menu-icon" value="|||"/>
                <label sclass="header-brand"     value="CTS BANKING / DASHBOARD"/>
            </div>

            <!-- Far right: date | last login | bell | avatar -->
            <div sclass="header-right">

                <div sclass="header-meta-group">
                    <label sclass="header-meta-icon" value="📅"/>
                    <label id="headerDate"           sclass="header-meta-text" value=""/>
                </div>

                <div sclass="header-divider"/>

                <div sclass="header-meta-group">
                    <label sclass="header-meta-icon" value="🕐"/>
                    <label id="headerLastLogin"      sclass="header-meta-text" value="Last Login : --"/>
                </div>

                <div sclass="header-divider"/>

                <div sclass="header-notif">
                    <label sclass="header-notif-icon"  value="🔔"/>
                    <label id="headerNotifBadge"        sclass="header-notif-badge" value="9"/>
                </div>

                <div sclass="header-avatar">
                    <label sclass="header-avatar-icon" value="👤"/>
                </div>

            </div>

        </div>


        <!-- ========================================================
             BODY ROW
             ======================================================== -->

        <hlayout sclass="shell-body" spacing="0">

            <vlayout sclass="shell-sidebar" spacing="0">

                <div id="navDashboard" sclass="nav-item">
                    <label sclass="nav-icon"  value="⌂"/>
                    <label sclass="nav-label" value="Dashboard"/>
                </div>

                <div id="navRoles" sclass="nav-item">
                    <label sclass="nav-icon"  value="◈"/>
                    <label sclass="nav-label" value="Role Management"/>
                </div>

                <div id="navUsers" sclass="nav-item">
                    <label sclass="nav-icon"  value="👤"/>
                    <label sclass="nav-label" value="User Management"/>
                </div>

                <div id="navBatch" sclass="nav-item">
                    <label sclass="nav-icon"  value="〜"/>
                    <label sclass="nav-label" value="Batch Monitoring"/>
                </div>

                <div id="navSession" sclass="nav-item">
                    <label sclass="nav-icon"  value="◎"/>
                    <label sclass="nav-label" value="Session Management"/>
                </div>

                <div id="navAudit" sclass="nav-item">
                    <label sclass="nav-icon"  value="≡"/>
                    <label sclass="nav-label" value="Audit Logs"/>
                </div>

            </vlayout>

            <div sclass="shell-content">
                <include id="contentArea" src="/admin/roles.zul"/>
            </div>

        </hlayout>

    </div>

</zk>
