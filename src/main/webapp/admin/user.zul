<?xml version="1.0" encoding="UTF-8"?>

<zk>

<?link rel="stylesheet" type="text/css" href="~./css/users.css"?>

    <!-- ============================================================
         USER MANAGEMENT CENTER
         ============================================================ -->

    <vlayout
        id="userManagementPage"
        width="100%"
         apply="com.cts.admin.controller.UserController"
        spacing="0"
        sclass="user-management-page">


        <!-- ========================================================
             PAGE HEADER
             ======================================================== -->

        <hbox
            id="userPageHeader"
            width="100%"
            align="center"
            spacing="0"
            sclass="user-page-header">


            <!-- LEFT SIDE -->

            <vlayout
                id="userPageHeaderLeft"
                hflex="1"
                spacing="0"
                sclass="user-page-header-left">

                <label
                    id="userManagementTitle"
                    value="User Management"
                    sclass="user-page-title"/>

                <label
                    id="userManagementSubtitle"
                    value="Manage system operators, assign operational roles, and regulate system access"
                    sclass="user-page-subtitle"/>

            </vlayout>


            <!-- RIGHT SIDE -->

            <button
                id="createUserButton"
                label="Create User"
                iconSclass="z-icon-user-plus"
                sclass="create-user-button"/>

        </hbox>


        <!-- ========================================================
             SEARCH / FILTER CARD
             ======================================================== -->

        <hbox
            id="userFilterCard"
            width="100%"
            align="center"
            spacing="0"
            sclass="user-filter-card">


            <!-- SEARCH -->

            <hbox
                id="userSearchContainer"
                hflex="1"
                align="center"
                spacing="0"
                sclass="user-search-container">

                <label
                    id="userSearchIcon"
                    value="⌕"
                    sclass="user-search-icon"/>

                <textbox
                    id="userSearchTextbox"
                    hflex="1"
                    height="43px"
                    placeholder="Search by username, full name, or user ID..."
                    sclass="user-search-textbox"/>

            </hbox>


            <!-- ROLE LABEL -->

            <label
                id="roleFilterLabel"
                value="Role:"
                sclass="user-filter-label"/>


            <!-- ROLE FILTER -->

            <combobox
                id="roleFilterCombobox"
                readonly="true"
                sclass="user-filter-combobox role-filter-combobox">

                <comboitem
                    id="allRolesItem"
                    label="All Roles"/>

            </combobox>


            <!-- STATUS LABEL -->

            <label
                id="statusFilterLabel"
                value="Status:"
                sclass="user-filter-label"/>


            <!-- STATUS FILTER -->

            <combobox
                id="statusFilterCombobox"
                readonly="true"
                sclass="user-filter-combobox status-filter-combobox">

                <comboitem
                    id="allStatusesItem"
                    label="All Statuses"/>

            </combobox>

        </hbox>


        <!-- ========================================================
             SYSTEM USERS CARD
             ======================================================== -->

        <div
            id="systemUsersCard"
            width="100%"
            sclass="system-users-card">


            <!-- CARD HEADER -->

            <hbox
                id="systemUsersHeader"
                width="100%"
                height="73px"
                align="center"
                spacing="0"
                sclass="system-users-header">

                <label
                    id="systemUsersTitle"
                    value="System Users"
                    sclass="system-users-title"/>

            </hbox>


            <!-- ====================================================
                 USER LISTBOX
                 ==================================================== -->

            <listbox
                id="userListbox"
                width="calc(100% - 60px)"
                sclass="user-listbox"
                emptyMessage="No users available">


                <!-- =================================================
                     STATIC HEADINGS
                     ================================================= -->

                <listhead
                    id="userListHead"
                    sizable="false"
                    menupopup="none">


                    <listheader
                        id="userIdHeader"
                        label="S.No"
                        width="10%"/>


                    <listheader
                        id="usernameHeader"
                        label="Username"
                        width="15%"/>


                    <listheader
                        id="fullNameHeader"
                        label="Full Name"
                        width="15%"/>


                    <listheader
                        id="assignedRoleHeader"
                        label="Assigned Role"
                        width="18%"/>


                    <listheader
                        id="userStatusHeader"
                        label="Status"
                        width="12%"
                        align="center"/>


                    <listheader
                        id="lastLoginHeader"
                        label="Last Login"
                        width="10%"
                        align="center"/>


                    <listheader
                        id="userActionsHeader"
                        label="Actions"
                        width="15%"
                        align="center"/>

                </listhead>


                <!-- =================================================
                     NO HARDCODED ROWS

                     DB
                       ↓
                     DAO
                       ↓
                     SERVICE
                       ↓
                     CONTROLLER
                       ↓
                     userListbox
                     ================================================= -->

            </listbox>
            <paging
    				id="userPaging"
    				pageSize="10"
    				detailed="true"
    				style="margin: 15px 30px 25px 30px;" />

        </div>

    </vlayout>

</zk>