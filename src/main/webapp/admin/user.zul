<?xml version="1.0" encoding="UTF-8"?>

<zk>

    <style src="/css/user.css"/>

    <!-- ============================================================
         USER MANAGEMENT CENTER
         ============================================================ -->

    <vlayout
        id="userManagementPage"
        width="100%"
        apply="com.cts.admin.controller.UserController"
        spacing="0"
        sclass="user-management-page">


        <!-- ========================================================
             PAGE HEADER
             ======================================================== -->

        <div sclass="user-page-header">

            <!-- LEFT: title + subtitle -->
            <vlayout
                id="userPageHeaderLeft"
                spacing="0"
                sclass="user-page-header-left">

                <label
                    id="userManagementTitle"
                    value="User Management"
                    sclass="user-page-title"/>

                <label
                    id="userManagementSubtitle"
                    value="Manage system operators, assign operational roles, and regulate system access"
                    sclass="user-page-subtitle"/>

            </vlayout>

            <!-- RIGHT: create button -->
            <button
                id="createUserButton"
                label="+ Create User"
                sclass="create-user-button"/>

        </div>


        <!-- ========================================================
             SEARCH / FILTER CARD
             ======================================================== -->

        <div sclass="user-filter-card">

            <!-- SEARCH BOX -->
            <hbox
                id="userSearchContainer"
                hflex="1"
                align="center"
                spacing="0"
                sclass="user-search-container">

                <label
                    id="userSearchIcon"
                    value="⌕"
                    sclass="user-search-icon"/>

                <textbox
                    id="userSearchTextbox"
                    hflex="1"
                    placeholder="Search by username, full name, or user ID..."
                    sclass="user-search-textbox"/>

            </hbox>

            <!-- SEARCH + CLEAR BUTTONS -->
            <button
                id="searchUserButton"
                label="Search"
                iconSclass="z-icon-search"
                sclass="btn-search"/>

            <button
                id="clearUserFilterButton"
                label="Clear"
                sclass="btn-clear"/>

            <!-- DIVIDER -->
            <div sclass="filter-divider"/>

            <!-- ROLE FILTER -->
            <label
                id="roleFilterLabel"
                value="Role"
                sclass="user-filter-label"/>

            <combobox
                id="roleFilterCombobox"
                readonly="true"
                sclass="user-filter-combobox role-filter-combobox">
                <comboitem id="roleInwardChecker"   label="INWARD_CHECKER"/>
                <comboitem id="roleInwardMaker"     label="INWARD_MAKER"/>
                <comboitem id="roleOutwardMaker"    label="OUTWARD_MAKER"/>
                <comboitem id="roleOutwardChecker"  label="OUTWARD_CHECKER"/>
                <comboitem id="roleCaptureOperator" label="CAPTURE_OPERATOR"/>
            </combobox>

            <!-- STATUS FILTER -->
            <label
                id="statusFilterLabel"
                value="Status"
                sclass="user-filter-label"/>

            <combobox
                id="statusFilterCombobox"
                readonly="true"
                sclass="user-filter-combobox status-filter-combobox">
                <comboitem id="userActive"   label="ACTIVE"/>
                <comboitem id="userInActive" label="INACTIVE"/>
            </combobox>

        </div>


        <!-- ========================================================
             SYSTEM USERS CARD
             ======================================================== -->

        <div
            id="systemUsersCard"
            width="100%"
            sclass="system-users-card">

            <!-- CARD HEADER -->
            <div sclass="system-users-header">
                <label
                    id="systemUsersTitle"
                    value="System Users"
                    sclass="system-users-title"/>
            </div>

            <!-- ====================================================
                 USER LISTBOX
                 ==================================================== -->

            <listbox
                id="userListbox"
                width="calc(100% - 48px)"
                sclass="user-listbox"
                emptyMessage="No users found">

                <listhead
                    id="userListHead"
                    sizable="false"
                    menupopup="none">

                    <listheader id="userIdHeader"       label="S.No"          width="8%"/>
                    <listheader id="usernameHeader"     label="Username"       width="17%"/>
                    <listheader id="fullNameHeader"     label="Full Name"      width="19%"/>
                    <listheader id="assignedRoleHeader" label="Assigned Role"  width="22%"/>
                    <listheader id="userStatusHeader"   label="Status"         width="16%" align="center"/>
                    <listheader id="userActionsHeader"  label="Actions"        width="18%" align="center"/>

                </listhead>

            </listbox>

            <paging
                id="userPaging"
                pageSize="10"
                detailed="true"
                sclass="user-paging"/>

        </div>

    </vlayout>

</zk>
