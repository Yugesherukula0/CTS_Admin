<?xml version="1.0" encoding="UTF-8"?>

<zk>

<?link rel="stylesheet" type="text/css" href="/css/roles.css"?>

    <!-- ============================================================
         ROLE MANAGEMENT - CENTER CONTENT ONLY
         
         This page assumes your existing:
         - Header
         - Sidebar
         - Main layout
         
         are already present in your parent ZUL.
         ============================================================ -->


    <!-- ============================================================
         CENTER PAGE
         ============================================================ -->

    <vlayout
        id="roleManagementPage"
        width="100%"
        spacing="0"
        sclass="role-management-page"
         apply="com.cts.admin.controller.RoleController">


        <!-- ========================================================
             PAGE HEADER
             ======================================================== -->

        <vlayout
            id="rolePageHeader"
            spacing="0"
            sclass="role-page-header">

            <label
                id="roleManagementTitle"
                value="Role Management"
                sclass="role-page-title"/>

            <label
                id="roleManagementSubtitle"
                value="Configured operational roles and their respective module permissions in the CTS application"
                sclass="role-page-subtitle"/>

        </vlayout>


        <!-- ========================================================
             INFORMATION MESSAGE
             ======================================================== -->

        <hbox
            id="roleInformationBox"
            width="100%"
            align="center"
            spacing="0"
            sclass="role-info-box">

            <label
                id="roleInformationIcon"
                value="ⓘ"
                sclass="role-info-icon"/>

            <label
                id="roleInformationText"
                value="The CTS system defines exactly 6 core operational roles for cheque processing across Batch Capture, Inward, and Outward clearing lifecycles."
                sclass="role-info-text"
                multiline="true"/>

        </hbox>


        <!-- ========================================================
             SYSTEM ROLES CARD
             ======================================================== -->

        <div
            id="systemRolesCard"
            width="100%"
            sclass="system-roles-card">


            <!-- ====================================================
                 CARD TITLE
                 ==================================================== -->

            <hbox
                id="systemRolesHeader"
                width="100%"
                sclass="system-roles-header"
                spacing="0">

                <label
                    id="systemRolesTitle"
                    value="System Roles"
                    sclass="system-roles-title"/>

            </hbox>


            <!-- ====================================================
                 ROLE LISTBOX
                 
                 IMPORTANT:
                 The listbox itself and the headings are STATIC.
                 
                 No role records are hardcoded here.
                 
                 Controller/Model will populate the rows.
                 ==================================================== -->

            <listbox
                id="roleListbox"
                sclass="role-listbox"
                emptyMessage="No roles available">


                <!-- =================================================
                     STATIC COLUMN HEADINGS
                     ================================================= -->

                <listhead
                    id="roleListHead"
                    sizable="false"
                    menupopup="none">


                    <!-- =============================================
                         ROLE NAME COLUMN
                         ============================================= -->

                    <listheader
                        id="roleNameHeader"
                        label="Role Name"
                        width="18%"/>


                    <!-- =============================================
                         DESCRIPTION COLUMN
                         ============================================= -->

                    <listheader
                        id="roleDescriptionHeader"
                        label="Description"
                        width="57%"/>


                    <!-- =============================================
                         STATUS COLUMN
                         ============================================= -->

                    <listheader
                        id="roleStatusHeader"
                        label="Status"
                        width="12%"
                        align="center"/>


                    <!-- =============================================
                         CREATED DATE COLUMN
                         ============================================= -->

                    <listheader
                        id="roleCreatedDateHeader"
                        label="Created Date"
                        width="13%"
                        align="center"/>

                </listhead>


                <!-- =================================================
                     NO HARDCODED ROWS
                     
                     Controller will populate roleListbox.
                     
                     Example flow:
                     
                     List<Role> roles = service.getRoles();
                     
                     for (Role role : roles) {
                         Listitem item = new Listitem();
                         ...
                         roleListbox.appendChild(item);
                     }
                     ================================================= -->

            </listbox>

        </div>

    </vlayout>

</zk>