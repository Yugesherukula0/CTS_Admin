<?xml version="1.0" encoding="UTF-8"?>

<zk>

    <style src="/css/roles.css"/>

    <vlayout
        id="roleManagementPage"
        width="100%"
        spacing="0"
        sclass="role-management-page"
        apply="com.cts.admin.controller.RoleController">


        <!-- ========================================================
             PAGE HEADER
             ======================================================== -->

        <vlayout
            id="rolePageHeader"
            spacing="0"
            sclass="role-page-header">

            <label
                id="roleManagementTitle"
                value="Roles"
                sclass="role-page-title"/>

            <label
                id="roleManagementSubtitle"
                value="Configured operational roles and their respective module permissions in the CTS application"
                sclass="role-page-subtitle"/>

        </vlayout>


        <!-- ========================================================
             SYSTEM ROLES CARD
             ======================================================== -->

        <vlayout
            id="systemRolesCard"
            width="100%"
            spacing="0"
            sclass="system-roles-card">


            <!-- ====================================================
                 CARD HEADER
                 ==================================================== -->

            <vlayout
                id="systemRolesHeader"
                spacing="0"
                sclass="system-roles-header">

                <label
                    id="systemRolesTitle"
                    value="System Roles"
                    sclass="system-roles-title"/>

            </vlayout>


            <!-- ====================================================
                 ROLE LISTBOX
                 ==================================================== -->

            <listbox
                id="roleListbox"
                sclass="role-listbox"
                sizedByContent="false"
                span="true"
                emptyMessage="No roles available">

                <listhead
                    id="roleListHead"
                    sizable="false"
                    menupopup="none">

                    <listheader
                        id="roleNameHeader"
                        label="Role Name"
                        width="22%"/>

                    <listheader
                        id="roleDescriptionHeader"
                        label="Description"
                        width="50%"/>

                    <listheader
                        id="roleStatusHeader"
                        label="Status"
                        width="28%"
                        align="center"/>

                </listhead>

                <!--
                    Rows populated by RoleController.
                    DB → DAO → SERVICE → CONTROLLER → roleListbox
                -->

            </listbox>

        </vlayout>

    </vlayout>

</zk>
