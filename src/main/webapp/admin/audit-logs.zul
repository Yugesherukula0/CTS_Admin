<?xml version="1.0" encoding="UTF-8"?>

<zk>

    <style>

        .placeholder-page {
            width: 100%;
            min-height: 500px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #F5F7FC;
            padding: 60px;
            box-sizing: border-box;
        }

        .placeholder-card {
            background: #FFFFFF;
            border: 1px solid #DDE4ED;
            border-radius: 12px;
            padding: 60px 80px;
            text-align: center;
            max-width: 560px;
            width: 100%;
            box-sizing: border-box;
        }

        .placeholder-card.z-vlayout {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .placeholder-icon {
            font-size: 52px !important;
            margin-bottom: 20px !important;
            display: block !important;
        }

        .placeholder-title {
            font-size: 24px !important;
            font-weight: 700 !important;
            color: #18243A !important;
            display: block !important;
            margin-bottom: 12px !important;
        }

        .placeholder-subtitle {
            font-size: 15px !important;
            color: #667085 !important;
            line-height: 1.6 !important;
            display: block !important;
            margin-bottom: 28px !important;
        }

        .placeholder-badge {
            display: inline-block;
            background: #FEF3C7;
            border: 1px solid #FDE68A;
            border-radius: 20px;
            padding: 6px 16px;
            font-size: 13px !important;
            font-weight: 600 !important;
            color: #92400E !important;
        }

    </style>

    <div sclass="placeholder-page">

        <vlayout sclass="placeholder-card" spacing="0">
            <label sclass="placeholder-icon"     value="📋"/>
            <label sclass="placeholder-title"    value="Audit Logs"/>
            <label sclass="placeholder-subtitle"
                   value="This module is currently under development and has not been implemented yet. Check back in a future release."
                   multiline="true"/>
            <label sclass="placeholder-badge"    value="🚧  Under Development"/>
        </vlayout>

    </div>

</zk>
