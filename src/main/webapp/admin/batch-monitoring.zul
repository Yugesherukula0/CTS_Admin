<?xml version="1.0" encoding="UTF-8"?>

<zk>

    <style src="/css/batchMonitoring.css"/>

    <!-- ============================================================
         BATCH MONITORING PAGE
         ============================================================ -->

    <vlayout
        id="batchMonitoringPage"
        apply="com.cts.admin.controller.BatchMonitoringController"
        width="100%"
        spacing="0"
        sclass="batch-page">


        <!-- ========================================================
             PAGE HEADER
             ======================================================== -->

        <label
            sclass="batch-page-title"
            value="Batch Monitoring"/>

        <label
            sclass="batch-page-subtitle"
            value="Real-time tracking of clearing batches across Batch Capture, Inward, and Outward cycles"/>


        <!-- ========================================================
             TAB / SEARCH BAR CARD
             ======================================================== -->

        <div sclass="batch-tab-card">

            <!-- LEFT: tab buttons -->
            <hbox
                align="center"
                spacing="8px"
                sclass="batch-tab-left">

                <button
                    id="tabBatchCapture"
                    sclass="batch-tab-btn batch-tab-active"
                    label="Batch Capture"/>

                <button
                    id="tabInward"
                    sclass="batch-tab-btn"
                    label="Inward Batches"/>

                <button
                    id="tabOutward"
                    sclass="batch-tab-btn"
                    label="Outward"/>

            </hbox>

            <!-- RIGHT: search box + button -->
            <hbox
                align="center"
                spacing="0"
                sclass="batch-search-wrapper">

                <hbox
                    align="center"
                    spacing="0"
                    sclass="batch-search-box">

                    <label
                        sclass="batch-search-icon"
                        value="&#x2315;"/>

                    <textbox
                        id="batchSearchTextbox"
                        width="200px"
                        height="34px"
                        placeholder="Search by Batch ID, User..."
                        sclass="batch-search-textbox"/>

                </hbox>

                <button
                    id="batchSearchButton"
                    sclass="batch-search-btn"
                    label="Search"/>

            </hbox>

        </div>


        <!-- ========================================================
             RESULTS CARD
             ======================================================== -->

        <vlayout
            spacing="0"
            sclass="batch-results-card">

            <!-- Dynamic title — updated by controller on tab switch -->
            <label
                id="batchSectionTitle"
                sclass="batch-results-title"
                value="Batch Capture Batches"/>

            <!-- ====================================================
                 LISTBOX — fixed headers, rows populated by controller
                 ==================================================== -->

            <listbox
                id="batchListbox"
                sclass="batch-listbox"
                sizedByContent="false"
                span="true"
                emptyMessage="No records available">

                <listhead sizable="false" menupopup="none">

                    <listheader
                        label="Batch ID"
                        width="8%"/>

                    <listheader
                        label="Branch"
                        width="9%"/>

                    <listheader
                        label="Cheque Count"
                        width="10%"/>

                    <listheader
                        label="Total Amount"
                        width="10%"/>

                    <listheader
                        label="Current Module"
                        width="11%"/>

                    <listheader
                        label="Status"
                        width="9%"/>

                    <listheader
                        label="Maker"
                        width="9%"/>

                    <listheader
                        label="Checker"
                        width="9%"/>

                    <listheader
                        label="Captured By"
                        width="9%"/>

                    <listheader
                        label="Created At"
                        width="17%"/>

                </listhead>

                <!--
                    Rows populated by BatchMonitoringController.
                    Same columns for all three tabs —
                    only data changes based on batch type.
                -->

            </listbox>

        </vlayout>

    </vlayout>

</zk>
