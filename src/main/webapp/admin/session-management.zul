<?xml version="1.0" encoding="UTF-8"?>

<?link rel="stylesheet" type="text/css" href="/style/sessionManagement.css"?>

<window id="win"
        apply="com.cts.admin.controller.SessionManagementController"
        width="100%"
        border="none"
        sclass="session-mgmt-page">

    <vlayout width="100%" spacing="20px">

        <vlayout sclass="page-header" spacing="4px">
            <label value="Session Management" sclass="page-title"/>
            <label value="Open and close clearing operational windows, control batch intake sessions, and review clearing cycle history"
                   sclass="page-subtitle"/>
        </vlayout>

        <vlayout id="activeSessionBox" width="100%" visible="false" sclass="session-card session-card-active">
            <hbox width="100%" align="center" sclass="session-card-toprow">
                <label value="CURRENT SESSION" sclass="card-caption" hflex="1"/>
                <label id="lblActivePill" value="ACTIVE" sclass="pill pill-active"/>
            </hbox>
            <label id="lblSessionName" value="Morning Session" sclass="session-name"/>
            <vlayout sclass="session-detail-list" spacing="2px">
                <hlayout>
                    <label value="Session ID:" sclass="detail-label"/>
                    <label id="lblSessionId" value="SES-20260903-04" sclass="detail-value"/>
                </hlayout>
                <hlayout>
                    <label value="Started At:" sclass="detail-label"/>
                    <label id="lblStartedAt" value="09:56 AM on 03 Sept 2026" sclass="detail-value"/>
                </hlayout>
                <hlayout>
                    <label value="Started By:" sclass="detail-label"/>
                    <label id="lblStartedBy" value="Demo User" sclass="detail-value"/>
                </hlayout>
            </vlayout>
            <button id="btnEndSession" label="&#x25A0;  End Current Session" sclass="btn btn-danger"/>
        </vlayout>

        <vlayout id="inactiveSessionBox" width="100%" visible="true" sclass="session-card session-card-inactive">
            <hbox width="100%" align="center" sclass="session-card-toprow">
                <label value="CURRENT SESSION" sclass="card-caption" hflex="1"/>
                <label value="NO ACTIVE SESSION" sclass="pill pill-inactive"/>
            </hbox>
            <label value="Clearing Window Closed" sclass="session-name"/>
            <label value="Start a new clearing session to allow batch capture and inward intake."
                   sclass="session-desc"/>
            <button id="btnBeginSession" label="&#x25B6;  Begin session" sclass="btn btn-success"/>
        </vlayout>

        <vlayout width="100%" sclass="history-card">
            <hlayout sclass="history-header">
                <label value="&#x23F0;" sclass="history-icon"/>
                <label value="Session History" sclass="history-title"/>
            </hlayout>

            <listbox id="historyListbox" width="100%" mold="default" sclass="history-listbox"
                     emptyMessage="No session history available">

                <listhead sizable="true">
                    <listheader label="Session ID"   width="11%"/>
                    <listheader label="Session Name" width="12%"/>
                    <listheader label="Session Type" width="11%"/>
                    <listheader label="Start Date"   width="11%"/>
                    <listheader label="Start Time"   width="11%"/>
                    <listheader label="End Time"     width="11%"/>
                    <listheader label="Status"       width="11%"/>
                    <listheader label="Started By"   width="11%"/>
                    <listheader label="Ended By"     width="11%"/>
                </listhead>

                <template name="model" var="row">
                    <listitem>
                        <listcell sclass="cell-session-id">
                            <a label="${row.sessionId}" sclass="session-id-link"/>
                        </listcell>
                        <listcell label="${row.sessionName}"/>
                        <listcell label="${row.sessionType}"/>
                        <listcell label="${row.startDate}"/>
                        <listcell sclass="cell-time-start" label="${row.startTime}"/>
                        <listcell sclass="cell-time-end"   label="${row.endTime}"/>
                        <listcell>
                            <label value="${row.status}"
                                   sclass="pill ${row.status eq 'ACTIVE' ? 'pill-active' : 'pill-ended'}"/>
                        </listcell>
                        <listcell label="${row.startedBy}"/>
                        <listcell label="${row.endedBy}"/>
                    </listitem>
                </template>

            </listbox>
        </vlayout>

    </vlayout>

    <window id="confirmEndSessionWin"
            title="Confirm End Session"
            border="normal"
            mode="modal"
            visible="false"
            closable="true"
            width="480px"
            sclass="confirm-modal">

        <vlayout spacing="14px" width="100%">
            <hlayout>
                <label value="Are you sure you want to end the active session (" sclass="confirm-title"/>
                <label id="lblConfirmSessionName" value="Morning Session" sclass="confirm-title-bold"/>
                <label value=")?" sclass="confirm-title"/>
            </hlayout>
            <label value="Ending the session will close the clearing window for current intake. Completed batches will remain tracked and logged."
                   sclass="confirm-subtext" multiline="true"/>
            <hlayout sclass="confirm-actions">
                <button id="btnCancel"     label="Cancel"                    sclass="btn btn-secondary"/>
                <button id="btnConfirmEnd" label="Confirm &amp; End Session" sclass="btn btn-danger"/>
            </hlayout>
        </vlayout>

    </window>

</window>
