<?xml version="1.0" encoding="UTF-8"?>

<zk>

    <style>

        /* ============================================================
           SESSION MANAGEMENT PAGE
           ============================================================ */

        .session-page {
            width: 100%;
            padding: 34px 40px 40px 40px;
            box-sizing: border-box;
            background: #F5F7FC;
        }


        /* ============================================================
           PAGE HEADER
           ============================================================ */

        .session-page-title {
            color: #18243A;
            font-size: 32px;
            font-weight: 700;
            line-height: 38px;
            display: block;
            white-space: nowrap;
        }

        .session-page-subtitle {
            color: #60738F;
            font-size: 16px;
            font-weight: 400;
            line-height: 22px;
            display: block;
            margin-top: 3px;
            margin-bottom: 28px;
            white-space: nowrap;
        }


        /* ============================================================
           CURRENT SESSION CARD — BASE
           ============================================================ */

        .current-session-card {
            width: 100%;
            background: #FFFFFF;
            border: 1px solid #DDE4ED;
            border-radius: 12px;
            padding: 24px 28px 28px 28px;
            box-sizing: border-box;
            margin-bottom: 24px;
        }

        .current-session-card.active {
            background: #F0FDF4;
            border-color: #BBF7D0;
        }


        /* ============================================================
           CURRENT SESSION — TOP ROW
           ============================================================ */

        .current-session-top {
            width: 100%;
            margin-bottom: 18px;
        }

        .current-session-label {
            color: #60738F;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.09em;
            text-transform: uppercase;
            margin-right: 12px;
        }


        /* ============================================================
           STATUS BADGE
           ============================================================ */

        .status-badge {
            display: inline-block;
            padding: 4px 13px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.04em;
            white-space: nowrap;
        }

        .status-inactive {
            background: #E5E7EB;
            color: #4B5563;
        }

        .status-active {
            background: #16A34A;
            color: #FFFFFF;
        }


        /* ============================================================
           CLOSED SESSION STATE
           ============================================================ */

        .closed-session-content {
            width: 100%;
        }

        .closed-session-title {
            color: #18243A;
            font-size: 22px;
            font-weight: 700;
            display: block;
            margin-bottom: 6px;
        }

        .closed-session-description {
            color: #60738F;
            font-size: 15px;
            display: block;
            margin-bottom: 20px;
        }

        .begin-session-button {
            height: 42px;
            min-width: 174px;
            background: #16A34A;
            border: 1px solid #16A34A;
            border-radius: 7px;
            color: #FFFFFF;
            font-size: 15px;
            font-weight: 600;
            padding: 0 20px;
            box-sizing: border-box;
            box-shadow: none;
        }

        .begin-session-button:hover {
            background: #15803D;
            border-color: #15803D;
        }


        /* ============================================================
           ACTIVE SESSION STATE
           ============================================================ */

        .active-session-content {
            width: 100%;
        }

        .active-session-name {
            color: #18243A;
            font-size: 22px;
            font-weight: 700;
            display: block;
            margin-bottom: 10px;
        }

        .session-detail {
            color: #475467;
            font-size: 15px;
            display: block;
            margin-bottom: 5px;
        }

        .end-session-button {
            height: 42px;
            min-width: 200px;
            background: #DC2626;
            border: 1px solid #DC2626;
            border-radius: 7px;
            color: #FFFFFF;
            font-size: 15px;
            font-weight: 600;
            padding: 0 20px;
            box-sizing: border-box;
            box-shadow: none;
            margin-top: 16px;
        }

        .end-session-button:hover {
            background: #B91C1C;
            border-color: #B91C1C;
        }


        /* ============================================================
           SESSION HISTORY CARD
           ============================================================ */

        .history-card {
            width: 100%;
            background: #FFFFFF;
            border: 1px solid #DDE4ED;
            border-radius: 12px;
            padding: 24px 28px 28px 28px;
            box-sizing: border-box;
        }


        /* ============================================================
           HISTORY HEADER
           ============================================================ */

        .history-header {
            width: 100%;
            margin-bottom: 18px;
        }

        .history-icon {
            color: #2454D6;
            font-size: 20px;
            margin-right: 8px;
        }

        .history-title {
            color: #18243A;
            font-size: 20px;
            font-weight: 700;
        }


        /* ============================================================
           HISTORY LISTBOX
           ============================================================ */

        .history-listbox {
            width: 100%;
            border: 1px solid #D9E1EB;
            border-radius: 8px;
            box-sizing: border-box;
            overflow: hidden;
        }

        .history-listbox .z-listhead {
            background: #F8FAFC;
        }

        .history-listbox .z-listheader {
            background: #F8FAFC;
            border-bottom: 1px solid #D9E1EB;
            border-right: 1px solid #D9E1EB;
            padding: 14px 16px;
            box-sizing: border-box;
            box-shadow: none;
        }

        .history-listbox .z-listheader:last-child {
            border-right: none;
        }

        .history-listbox .z-listheader-content {
            color: #18243A;
            font-size: 14px;
            font-weight: 700;
        }

        .history-listbox .z-listitem {
            background: #FFFFFF;
            border-bottom: 1px solid #F3F4F6;
        }

        .history-listbox .z-listitem:last-child {
            border-bottom: none;
        }

        .history-listbox .z-listitem:hover {
            background: #F9FAFB;
        }

        .history-listbox .z-listcell {
            padding: 14px 16px;
            border-right: none;
            box-sizing: border-box;
        }

        .history-listbox .z-listcell-content {
            font-size: 14px;
            color: #374151;
        }

        .history-listbox .z-listbox-emptybody td {
            color: #98A2B3;
            font-size: 14px;
            text-align: center;
            padding: 32px 0;
        }


        /* ============================================================
           HISTORY CELL LABELS
           ============================================================ */

        .session-id {
            color: #2454D6;
            font-size: 14px;
            font-weight: 700;
        }

        .session-name {
            color: #18243A;
            font-size: 14px;
            font-weight: 600;
        }

        .session-type {
            color: #374151;
            font-size: 14px;
        }

        .session-date {
            color: #374151;
            font-size: 14px;
        }

        .start-time {
            color: #16A34A;
            font-size: 14px;
            font-weight: 600;
        }

        .end-time {
            color: #DC2626;
            font-size: 14px;
            font-weight: 600;
        }

        .in-progress {
            color: #D97706;
            font-size: 14px;
            font-weight: 600;
        }

        .table-status-active {
            color: #16A34A;
            font-size: 13px;
            font-weight: 700;
        }

        .table-status-ended {
            color: #6B7280;
            font-size: 13px;
            font-weight: 700;
        }

        .session-user {
            color: #475467;
            font-size: 14px;
        }


        /* ============================================================
           END SESSION MODAL
           ============================================================ */

        .end-session-modal {
            width: 480px;
            background: #FFFFFF;
            border-radius: 12px;
            border: 1px solid #DDE4ED;
            box-shadow: 0 8px 32px rgba(0,0,0,0.12);
            overflow: hidden;
        }

        .end-session-modal .z-window-content {
            padding: 0;
        }

        .modal-header {
            width: 100%;
            padding: 20px 24px 16px 24px;
            border-bottom: 1px solid #E5E7EB;
            box-sizing: border-box;
        }

        .modal-title {
            color: #18243A;
            font-size: 18px;
            font-weight: 700;
            flex: 1;
        }

        .modal-close {
            width: 32px;
            height: 32px;
            min-width: 32px;
            background: #F3F4F6;
            border: none;
            border-radius: 6px;
            color: #6B7280;
            font-size: 18px;
            font-weight: 400;
            padding: 0;
            box-shadow: none;
            line-height: 1;
        }

        .modal-close:hover {
            background: #E5E7EB;
            color: #18243A;
        }

        .modal-body {
            width: 100%;
            padding: 20px 24px;
            box-sizing: border-box;
        }

        .modal-question {
            color: #18243A;
            font-size: 15px;
            font-weight: 600;
            display: block;
            margin-bottom: 10px;
        }

        .modal-description {
            color: #60738F;
            font-size: 14px;
            line-height: 1.5;
            display: block;
        }

        .modal-footer {
            width: 100%;
            padding: 16px 24px 20px 24px;
            border-top: 1px solid #E5E7EB;
            box-sizing: border-box;
        }

        .modal-cancel {
            height: 40px;
            min-width: 100px;
            background: #FFFFFF;
            border: 1px solid #D1D5DB;
            border-radius: 7px;
            color: #374151;
            font-size: 14px;
            font-weight: 600;
            padding: 0 18px;
            box-shadow: none;
        }

        .modal-cancel:hover {
            background: #F9FAFB;
        }

        .modal-confirm {
            height: 40px;
            min-width: 190px;
            background: #DC2626;
            border: 1px solid #DC2626;
            border-radius: 7px;
            color: #FFFFFF;
            font-size: 14px;
            font-weight: 600;
            padding: 0 18px;
            box-shadow: none;
        }

        .modal-confirm:hover {
            background: #B91C1C;
            border-color: #B91C1C;
        }

    </style>


    <!-- ============================================================
         SESSION MANAGEMENT PAGE
         ============================================================ -->

    <vlayout
        id="sessionManagementPage"
        width="100%"
        spacing="0"
        sclass="session-page">


        <!-- ========================================================
             PAGE HEADER
             ======================================================== -->

        <label
            id="sessionPageTitle"
            sclass="session-page-title"
            value="Session Management"/>

        <label
            id="sessionPageSubtitle"
            sclass="session-page-subtitle"
            value="Open and close clearing operational windows, control batch intake sessions, and review clearing cycle history"/>


        <!-- ========================================================
             CURRENT SESSION CARD
             ======================================================== -->

        <vlayout
            id="currentSessionCard"
            sclass="current-session-card"
            spacing="0">


            <!-- TOP ROW -->

            <hlayout
                sclass="current-session-top"
                spacing="0"
                valign="middle">

                <label
                    sclass="current-session-label"
                    value="CURRENT SESSION"/>

                <label
                    id="sessionStatusBadge"
                    sclass="status-badge status-inactive"
                    value="NO ACTIVE SESSION"/>

            </hlayout>


            <!-- ====================================================
                 CLOSED STATE
                 ==================================================== -->

            <vlayout
                id="closedSessionContent"
                sclass="closed-session-content"
                spacing="0">

                <label
                    sclass="closed-session-title"
                    value="Clearing Window Closed"/>

                <label
                    sclass="closed-session-description"
                    value="Start a new clearing session to allow batch capture and inward intake."/>

                <button
                    id="beginSessionButton"
                    sclass="begin-session-button"
                    label="&#x25B6;   Begin session"/>

            </vlayout>


            <!-- ====================================================
                 ACTIVE STATE
                 ==================================================== -->

            <vlayout
                id="activeSessionContent"
                sclass="active-session-content"
                spacing="0"
                visible="false">

                <label
                    id="activeSessionName"
                    sclass="active-session-name"
                    value=""/>

                <label
                    id="activeSessionId"
                    sclass="session-detail"
                    value=""/>

                <label
                    id="activeSessionStartedAt"
                    sclass="session-detail"
                    value=""/>

                <label
                    id="activeSessionStartedBy"
                    sclass="session-detail"
                    value=""/>

                <button
                    id="endSessionButton"
                    sclass="end-session-button"
                    label="&#x25A0;   End Current Session"/>

            </vlayout>

        </vlayout>


        <!-- ========================================================
             SESSION HISTORY CARD
             ======================================================== -->

        <vlayout
            sclass="history-card"
            spacing="0">


            <!-- HISTORY TITLE -->

            <hlayout
                sclass="history-header"
                spacing="0"
                valign="middle">

                <label
                    sclass="history-icon"
                    value="&#x25D7;"/>

                <label
                    sclass="history-title"
                    value="Session History"/>

            </hlayout>


            <!-- ====================================================
                 SESSION HISTORY LISTBOX
                 ==================================================== -->

            <listbox
                id="sessionHistoryListbox"
                sclass="history-listbox"
                sizedByContent="false"
                span="true"
                emptyMessage="No session history available">

                <listhead sclass="history-listhead">

                    <listheader
                        label="Session ID"
                        width="14%"/>

                    <listheader
                        label="Session Name"
                        width="14%"/>

                    <listheader
                        label="Session Type"
                        width="13%"/>

                    <listheader
                        label="Start Date"
                        width="12%"/>

                    <listheader
                        label="Start Time"
                        width="10%"/>

                    <listheader
                        label="End Time"
                        width="10%"/>

                    <listheader
                        label="Status"
                        width="10%"/>

                    <listheader
                        label="Started By"
                        width="9%"/>

                    <listheader
                        label="Ended By"
                        width="8%"/>

                </listhead>

                <!--
                =====================================================
                CONTROLLER-POPULATED ROWS

                Example row structure for SessionManagementController:

                <listitem sclass="history-row">
                    <listcell><label sclass="session-id"     value="SES-20260903-04"/></listcell>
                    <listcell><label sclass="session-name"   value="Morning Session"/></listcell>
                    <listcell><label sclass="session-type"   value="Regular Clearing"/></listcell>
                    <listcell><label sclass="session-date"   value="03 Sept 2026"/></listcell>
                    <listcell><label sclass="start-time"     value="09:56 AM"/></listcell>
                    <listcell><label sclass="in-progress"    value="In Progress"/></listcell>
                    <listcell><label sclass="table-status-active" value="&#x2713; ACTIVE"/></listcell>
                    <listcell><label sclass="session-user"   value="Demo User"/></listcell>
                    <listcell><label sclass="session-user"   value="-"/></listcell>
                </listitem>
                =====================================================
                -->

            </listbox>

        </vlayout>

    </vlayout>


    <!-- ============================================================
         END SESSION CONFIRMATION MODAL
         ============================================================ -->

    <window
        id="endSessionModal"
        sclass="end-session-modal"
        border="none"
        closable="false"
        sizable="false"
        position="center"
        mode="modal"
        visible="false">

        <vlayout spacing="0">

            <!-- MODAL HEADER -->

            <hlayout
                sclass="modal-header"
                spacing="0"
                valign="middle">

                <label
                    sclass="modal-title"
                    hflex="1"
                    value="Confirm End Session"/>

                <button
                    id="modalCloseButton"
                    sclass="modal-close"
                    label="&#x00D7;"/>

            </hlayout>


            <!-- MODAL BODY -->

            <vlayout
                sclass="modal-body"
                spacing="0">

                <label
                    id="modalQuestion"
                    sclass="modal-question"
                    value="Are you sure you want to end the active session?"/>

                <label
                    sclass="modal-description"
                    value="Ending the session will close the clearing window for current intake. Completed batches will remain tracked and logged."/>

            </vlayout>


            <!-- MODAL FOOTER -->

            <hlayout
                sclass="modal-footer"
                spacing="12px"
                valign="middle">

                <button
                    id="modalCancelButton"
                    sclass="modal-cancel"
                    label="Cancel"/>

                <button
                    id="modalConfirmButton"
                    sclass="modal-confirm"
                    label="Confirm &amp; End Session"/>

            </hlayout>

        </vlayout>

    </window>

</zk>
